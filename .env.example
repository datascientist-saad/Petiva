# Animivo environment variables
# Copy to .env.local and fill in values

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (required for auth redirects & invites)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (optional — safe fallback used when missing)
OPENAI_API_KEY=

# Admin pilot dashboard — comma-separated emails
ADMIN_EMAILS=you@example.com

# AI daily message limit per user
AI_DAILY_MESSAGE_LIMIT=20
